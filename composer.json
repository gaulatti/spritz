{
    "name": "spritz/wordpress",
    "description": "Headless WordPress CMS — part of the Cronkite stack",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "johnpbloch/wordpress": "^7.0",
        "composer/installers": "^2.3",
        "wpackagist-plugin/advanced-custom-fields": "^6.3",
        "wpackagist-plugin/amazon-s3-and-cloudfront": "^3.0",
        "wpackagist-plugin/daggerhart-openid-connect-generic": "^3.11",
        "aws/aws-sdk-php": "^3.337"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "wpackagist-plugin/advanced-custom-fields",
                "version": "6.8.8",
                "type": "wordpress-plugin",
                "dist": {
                    "url": "https://downloads.wordpress.org/plugin/advanced-custom-fields.6.8.8.zip",
                    "type": "zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "wpackagist-plugin/amazon-s3-and-cloudfront",
                "version": "3.3.1",
                "type": "wordpress-plugin",
                "dist": {
                    "url": "https://downloads.wordpress.org/plugin/amazon-s3-and-cloudfront.3.3.1.zip",
                    "type": "zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "wpackagist-plugin/daggerhart-openid-connect-generic",
                "version": "3.11.3",
                "type": "wordpress-plugin",
                "dist": {
                    "url": "https://downloads.wordpress.org/plugin/daggerhart-openid-connect-generic.3.11.3.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "extra": {
        "wordpress-install-dir": "wordpress"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "johnpbloch/wordpress-core-installer": true
        }
    }
}
